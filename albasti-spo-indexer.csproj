<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>albasti_spo_indexer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Azure.Data.Tables" Version="12.11.0" />
    <PackageReference Include="Azure.Storage.Queues" Version="12.25.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.ApplicationInsights.WorkerService" Version="2.23.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.51.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="2.50.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Queues" Version="5.3.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.7" />
  </ItemGroup>

  <!--
    UglyToad.PdfPig 1.7.0-custom-5 is a private/custom build with no public NuGet feed.
    It is referenced directly from the committed DLLs in libs/ instead of via PackageReference.
  -->
  <ItemGroup>
    <Reference Include="UglyToad.PdfPig">
      <HintPath>libs\UglyToad.PdfPig.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UglyToad.PdfPig.Core">
      <HintPath>libs\UglyToad.PdfPig.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UglyToad.PdfPig.Fonts">
      <HintPath>libs\UglyToad.PdfPig.Fonts.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UglyToad.PdfPig.Tokenization">
      <HintPath>libs\UglyToad.PdfPig.Tokenization.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UglyToad.PdfPig.Tokens">
      <HintPath>libs\UglyToad.PdfPig.Tokens.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
